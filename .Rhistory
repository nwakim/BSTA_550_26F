# Density used for the plots comparing discrete and continuous RVs
dens_two_humps <- function(x) {
0.55 * dnorm(x, mean = 2.5, sd = 1) + 0.45 * dnorm(x, mean = 7, sd = 1.2)
}
# Plot of the uniform pdf f(x) = 2 on [2.5, 3] (no shading: drawn in class)
plot_unif <- function(a_label = FALSE) {
tick_labels <- c("2.5", "3")
if (a_label) tick_labels[1] <- "a"
ggplot() +
geom_rect(aes(xmin = 2.5, xmax = 3, ymin = 0, ymax = 2), fill = "lightblue") +
geom_segment(aes(x = 2.3, xend = 3.2, y = 0, yend = 0)) +
scale_x_continuous(breaks = c(2.5, 3), labels = tick_labels, limits = c(2.3, 3.2)) +
scale_y_continuous(breaks = c(0, 1, 2), limits = c(0, 2.5)) +
labs(x = "x", y = expression(f[X](x))) +
theme_minimal(base_size = 30) +
theme(axis.text = element_text(size = 30),
axis.title = element_text(size = 34))
}
#| fig-height: 6
#| fig-width: 7
#| fig-align: center
#| echo: false
pmf_example <- tibble(x = c(1, 3, 6, 8), prob = c(0.2, 0.3, 0.2, 0.3))
ggplot(pmf_example, aes(x = x, y = prob)) +
geom_segment(aes(xend = x, yend = 0), linewidth = 1.5) +
geom_point(size = 5) +
scale_x_continuous(breaks = 0:10, limits = c(0, 10)) +
scale_y_continuous(limits = c(0, 0.5)) +
labs(x = "x", y = "Probability") +
theme_minimal(base_size = 28)
#| fig-height: 6
#| fig-width: 7
#| fig-align: center
#| echo: false
curve_df <- tibble(x = seq(0, 10, by = 0.02)) |>
mutate(density = dens_two_humps(x))
ggplot(curve_df, aes(x = x, y = density)) +
geom_area(data = filter(curve_df, x >= 2, x <= 7),
fill = "#20c997", alpha = 0.5) +
geom_line(linewidth = 1.2) +
geom_vline(xintercept = c(2, 7), linetype = "dashed") +
scale_x_continuous(breaks = c(0, 2, 5, 7, 10), labels = c("0", "a", "5", "b", "10")) +
labs(x = "x", y = "Density") +
theme_minimal(base_size = 28)
#| fig-height: 6
#| fig-width: 9
#| fig-align: center
#| echo: false
pdf_df <- tibble(x = seq(1, 9, by = 0.02)) |>
mutate(u = (x - 1) / 8,
density = (0.5 * dbeta(u, 2, 6) + 0.5 * dbeta(u, 6, 2)) / 8)
ggplot(pdf_df, aes(x = x, y = density)) +
geom_area(fill = "lightblue") +
geom_line(linewidth = 1.2) +
annotate("text", x = 5, y = 0.04, label = "Area = 1", size = 9) +
scale_x_continuous(breaks = c(1, 9), labels = c("c", "d"), limits = c(0, 10)) +
labs(x = "x", y = "Density") +
theme_minimal(base_size = 50)

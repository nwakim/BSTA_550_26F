# =============================================================================
# De-identify student submissions downloaded from Brightspace
# PUBH 523, Practice 1
#
# Expected input: one folder per student, each holding that student's .qmd and
# rendered .html, e.g.
#
#   practice_01_submissions/
#     123456-789012 - Jane Smith - Oct 5, 2026 1015 AM/
#       practice_01.qmd
#       practice_01.html
#     123457-789013 - Luis Ortega - Oct 5, 2026 1130 PM/
#       ...
#
# Output: one folder per student, named by a random code:
#
#   practice_01_deidentified/       <- the ONLY folder to upload
#     S07/  S07.qmd  S07.html
#     S12/  S12.qmd  S12.html
#   practice_01_PRIVATE/            <- keep on your computer, never upload
#     KEY_do_not_upload.csv         (code <-> student)
#     REVIEW_do_not_upload.txt      (what was replaced, lines worth a look)
#
# What it removes
#   * YAML fields in the .qmd (author, name, email, affiliation, id, ...),
#     replaced by  author: "S07".
#   * The student's name everywhere in both files (title, text, code, comments,
#     the rendered title block and <meta name="author"> in the HTML). Names are
#     taken from the Brightspace folder/file names, the .qmd YAML, and the HTML.
#   * Names found in ANY submission are replaced in EVERY submission, so a
#     classmate mentioned as a collaborator gets their code too.
#   * Brightspace submission/user ID numbers, email addresses ([EMAIL]), and
#     computer usernames in file paths (/Users/janesmith/... -> /Users/[USER]/...).
#   * Embedded images, scripts and styles inside the HTML are left untouched so
#     the page still displays correctly.
#
# Only .qmd and .html files are copied. Anything else in a student's folder
# (data files, images, Word docs) is listed in the review report, not copied.
# Brightspace's own top-level index.html lists every student's name: it is
# skipped automatically. Don't upload it.
#
# Base R only: nothing to install. Your original files are never changed.
# =============================================================================
# ---- Settings (edit these) --------------------------------------------------
input_dir   <- "practice_01_submissions"   # the unzipped Brightspace download
output_dir  <- "practice_01_deidentified"  # de-identified copies (the ONLY folder to upload)
private_dir <- "practice_01_PRIVATE"       # key + review report (never upload)
# Optional: a CSV with columns first_name, last_name, and optionally
# preferred_name, email, student_id. Catches classmates mentioned in a file
# even if they didn't submit. Leave as NA to skip.
roster_file <- NA
code_prefix <- "S"
# TRUE also replaces first and last names on their own (case-sensitive,
# e.g. "Jane" or "Smith"). This catches "Thanks, Jane!" but can occasionally
# replace an ordinary capitalized word when a student's name is also a word
# (e.g. "Will", "May"). Every replacement is listed in the review report.
replace_single_names <- TRUE
# -----------------------------------------------------------------------------
# ---- Checks and setup -------------------------------------------------------
if (!dir.exists(input_dir)) stop("Can't find input_dir: ", input_dir)
# ---- Checks and setup -------------------------------------------------------
if (!dir.exists(input_dir)) stop("Can't find input_dir: ", input_dir)
input_dir
